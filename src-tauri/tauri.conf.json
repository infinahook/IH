{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IH",
  "version": "0.6.2",
  "identifier": "dev.ih.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IH — Intelligence Hub",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Development",
    "shortDescription": "Harness de développement IA",
    "longDescription": "IH orchestre des agents de développement locaux et cloud sur Linux.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/doc/ih/copyright": "../LICENSE"
        }
      }
    },
    "copyright": "Copyright (c) 2026 Infinahook — MIT"
  }
}
